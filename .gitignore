# Python virtual environments and caches
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# Local work directory containing logs, pids, browser profiles, and database files
work/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Development evidence and static-analysis caches
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Operator backup files are local state, never build or source inputs.
*.bak
*.bak-*

# Kanban task/config files are tracked; CLI locks and event logs are runtime state.
kanban/.lock
kanban/activity.jsonl
